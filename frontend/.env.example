# Copy to frontend/.env (or set in your Vercel/Netlify project) for production builds.
# Leave UNSET in development so Vite's proxy (vite.config.js) forwards /api/* to localhost:8001.
#
# In production set this to the absolute origin of your deployed FastAPI backend, e.g.
#   VITE_API_BASE_URL=https://pierce-portfolio-api.onrender.com
VITE_API_BASE_URL=
