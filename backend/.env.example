# Copy to backend/.env and fill in real values
DATABASE_URL=sqlite://db.sqlite3

# Required
OPENAI_API_KEY=sk-...

# Chat — defaults shown
OPENAI_MODEL=gpt-4o-mini
CHAT_MAX_HISTORY=10
CHAT_MAX_TOKENS=400
CHAT_MAX_USER_CHARS=2000
CHAT_TEMPERATURE=0.7

# RAG — defaults shown
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=3

# Rate limiting (per client IP) — defaults shown
CHAT_RATE_LIMIT_PER_MINUTE=15
CHAT_RATE_LIMIT_PER_DAY=100
