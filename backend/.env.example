# Copy to backend/.env and fill in real values
DATABASE_URL=sqlite://db.sqlite3

# CORS — comma-separated list of frontend origins permitted to call the API.
# Dev default already includes the Vite dev server. In production set this to
# your deployed frontend, e.g. https://pierce-doman.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Required
OPENAI_API_KEY=sk-...

# Chat — defaults shown
OPENAI_MODEL=gpt-4o-mini
CHAT_MAX_HISTORY=10
CHAT_MAX_TOKENS=400
CHAT_MAX_USER_CHARS=2000
CHAT_TEMPERATURE=0.7

# RAG — defaults shown
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=3

# Rate limiting (per client IP) — defaults shown
CHAT_RATE_LIMIT_PER_MINUTE=15
CHAT_RATE_LIMIT_PER_DAY=100

# AI Games — model + rate limits (defaults shown)
GAMES_MODEL=gpt-4o-mini
GAMES_RATE_LIMIT_PER_MINUTE=10
GAMES_RATE_LIMIT_PER_DAY=60

# Contact form / email (Gmail SMTP example — use a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=piercedoman25@gmail.com
SMTP_PASSWORD=your-16-char-app-password
CONTACT_TO_EMAIL=piercedoman25@gmail.com
CONTACT_FROM_NAME=Portfolio Contact Form
CONTACT_RATE_PER_HOUR=3
CONTACT_RATE_PER_DAY=10
